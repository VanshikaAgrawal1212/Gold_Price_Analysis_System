# Copy to .env (same folder) - configs/settings.py loads it automatically.
# Everything here is optional; the defaults in settings.py work out of the box.

# How many business days ahead the model predicts.
FORECAST_HORIZON=5

# History window. Yahoo needs daily bars; 2010 gives ~4000 rows, which is
# enough for walk-forward CV without letting old regimes dominate.
DATA_START_DATE=2010-01-01
# Leave empty to mean "up to today".
DATA_END_DATE=

# Only needed if you swap FRED's keyless CSV endpoint for the authenticated API.
# Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
